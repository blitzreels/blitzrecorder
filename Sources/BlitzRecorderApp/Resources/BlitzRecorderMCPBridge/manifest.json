{
  "manifest_version": "0.3",
  "name": "blitzrecorder",
  "display_name": "BlitzRecorder",
  "version": "1.1.0",
  "description": "Read local recordings, transcripts and video frames, and create MP4 exports with BlitzRecorder.",
  "author": { "name": "BlitzRecorder" },
  "server": {
    "type": "node",
    "entry_point": "bridge.cjs",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/bridge.cjs"]
    }
  },
  "compatibility": { "platforms": ["darwin"], "runtimes": { "node": ">=18" } },
  "license": "AGPL-3.0-only"
}
