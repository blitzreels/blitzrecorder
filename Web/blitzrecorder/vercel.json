{
  "routes": [
    {
      "src": "^/(.*)$",
      "has": [{ "type": "host", "value": "www.blitzrecorder.com" }],
      "status": 308,
      "headers": { "Location": "https://blitzrecorder.com/$1" }
    },
    { "src": "^/brand-guidelines\\.html$", "status": 308, "headers": { "Location": "/brand-guidelines" } },
    { "src": "^/ios-app-store\\.html$", "status": 308, "headers": { "Location": "/ios" } },
    { "src": "^/macos-app-store\\.html$", "status": 308, "headers": { "Location": "/macos" } },
    { "src": "^/privacy\\.html$", "status": 308, "headers": { "Location": "/privacy" } },
    { "src": "^/support\\.html$", "status": 308, "headers": { "Location": "/support" } },
    { "src": "^/terms\\.html$", "status": 308, "headers": { "Location": "/terms" } },
    { "handle": "filesystem" },
    { "src": "^/(brand-guidelines|ios|ios-app-store|macos|macos-app-store|privacy|support|terms)$", "dest": "/index.html" }
  ]
}
